# Absolute base URL of the API (origin + /api/v2 prefix) for split deploys
# where the client and API live on different hosts, e.g.:
#   VITE_API_URL=https://studynotion-v2-api.onrender.com/api/v2
# Baked in at BUILD time (Vite static replacement) — changing it needs a rebuild.
# Leave empty for local dev: the Vite dev server proxies /api to :4000.
VITE_API_URL=
