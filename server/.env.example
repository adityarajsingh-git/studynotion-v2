PORT=4000
# Your MongoDB connection string (e.g. MongoDB Atlas).
# REQUIRED outside development/test — the server refuses to boot without it.
# Dev may leave it empty: the API starts with a warning and DB routes fail.
MONGODB_URL=
# REQUIRED in production — the server refuses to boot without it.
# Dev/test fall back to a public, insecure value. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=
# Allowed browser origin(s) for CORS. Comma-separated for multiple origins,
# NO spaces around commas (the value is split on "," verbatim):
#   CORS_ORIGIN=https://your-site.netlify.app,http://localhost:5173
# Production: set this to your deployed client URL (e.g. the Netlify site).
CORS_ORIGIN=http://localhost:5173
